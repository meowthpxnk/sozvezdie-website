# Copy to .test.env for docker compose (never commit .test.env).
# Fill secrets from your own CDEK / DaData / YooKassa / VK dashboards.

DATABASE_URI=postgresql+asyncpg://app_user:app_password@postgres:5432/app_db
REDIS_URI=redis://redis:6379
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
API_ROOT_PATH=/api
REFRESH_COOKIE_SECURE=true

MINIO_URI=minio://minio99:minio123@minio:9000/images-bucket

SUPER_MODERATOR_USERNAME=admin
SUPER_MODERATOR_PASSWORD=change-me
BLOCKED_1C_USERS=false

VK_API_VERSION=5.199
VK_OAUTH_DOMAIN=id.vk.ru
VK_CLIENT_ID=
VK_REDIRECT_URI=http://localhost:3000

CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_BASE=https://api.edu.cdek.ru
CDEK_FROM_CITY_CODE=137
CDEK_FROM_ADDRESS=
CDEK_DEFAULT_WEIGHT_G=1000
CDEK_DEFAULT_LENGTH_CM=20
CDEK_DEFAULT_WIDTH_CM=20
CDEK_DEFAULT_HEIGHT_CM=10

DADATA_API_KEY=
DADATA_SECRET_KEY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/orders/payment/return

AMQP_URL=amqp://guest:guest@rabbitmq:5672
